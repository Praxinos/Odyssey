#define ODYSSEY_COLORBLENDMODE_Screen 10
#define ODYSSEY_COLORBLENDMODE_ColorDodge 11
#define ODYSSEY_COLORBLENDMODE_LinearDodge 12
#define ODYSSEY_COLORBLENDMODE_LighterColor 13

#define ODYSSEY_COLORBLENDMODE_Overlay 14
#define ODYSSEY_COLORBLENDMODE_SoftLight 15
#define ODYSSEY_COLORBLENDMODE_HardLight 16
#define ODYSSEY_COLORBLENDMODE_VividLight 17
#define ODYSSEY_COLORBLENDMODE_LinearLight 18
