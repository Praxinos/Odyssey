// AlphaBlendMode
#define ODYSSEY_ALPHABLENDMODE_Normal 0

#define ODYSSEY_ALPHABLENDMODE_Erase 1

#define ODYSSEY_ALPHABLENDMODE_Top 2
#define ODYSSEY_ALPHABLENDMODE_Back 3

#define ODYSSEY_ALPHABLENDMODE_Substract 4
#define ODYSSEY_ALPHABLENDMODE_Add 5
#define ODYSSEY_ALPHABLENDMODE_Multiply 6

#define ODYSSEY_ALPHABLENDMODE_Min 7
#define ODYSSEY_ALPHABLENDMODE_Max 8

#define ODYSSEY_ALPHABLENDMODE_Dissolve 9
#define ODYSSEY_ALPHABLENDMODE_BayerDither8x8 10

float GetBayerDither8x8(uint2 iDstPos)
{
    float gBayer8x8Matrix[64] = {
        0.015625f, 0.765625f, 0.203125f, 0.953125f, 0.0625f, 0.8125f, 0.25f, 1.0f,
        0.515625f, 0.265625f, 0.703125f, 0.453125f, 0.5625f, 0.3125f, 0.75f, 0.5f,
        0.140625f, 0.890625f, 0.078125f, 0.828125f, 0.1875f, 0.9375f, 0.125f, 0.875f,
        0.640625f, 0.390625f, 0.578125f, 0.328125f, 0.6875f, 0.4375f, 0.625f, 0.375f,
        0.046875f, 0.796875f, 0.234375f, 0.984375f, 0.03125f, 0.78125f, 0.21875f, 0.96875f,
        0.546875f, 0.296875f, 0.734375f, 0.484375f, 0.53125f, 0.28125f, 0.71875f, 0.46875f,
        0.171875f, 0.921875f, 0.109375f, 0.859375f, 0.15625f, 0.90625f, 0.09375f, 0.84375f,
        0.671875f, 0.421875f, 0.609375f, 0.359375f, 0.65625f, 0.40625f, 0.59375f, 0.34375f
    };

    uint bayerX = iDstPos.x % 8;
    uint bayerY = iDstPos.y % 8;
    return gBayer8x8Matrix[bayerY * 8 + bayerX];
}

bool IsBlendSeparable(uint iBlendingMode)
{
    switch (iBlendingMode)
    {
        case ODYSSEY_COLORBLENDMODE_Normal:
        case ODYSSEY_COLORBLENDMODE_Top:
        case ODYSSEY_COLORBLENDMODE_Back:
        case ODYSSEY_COLORBLENDMODE_Behind:
        case ODYSSEY_COLORBLENDMODE_Darken:
        case ODYSSEY_COLORBLENDMODE_Multiply:
        case ODYSSEY_COLORBLENDMODE_ColorBurn:
        case ODYSSEY_COLORBLENDMODE_LinearBurn:
        case ODYSSEY_COLORBLENDMODE_Lighten:
        case ODYSSEY_COLORBLENDMODE_Screen:
        case ODYSSEY_COLORBLENDMODE_ColorDodge:
        case ODYSSEY_COLORBLENDMODE_LinearDodge:
        case ODYSSEY_COLORBLENDMODE_Overlay:
        case ODYSSEY_COLORBLENDMODE_SoftLight:
        case ODYSSEY_COLORBLENDMODE_HardLight:
        case ODYSSEY_COLORBLENDMODE_VividLight:
        case ODYSSEY_COLORBLENDMODE_LinearLight:
        case ODYSSEY_COLORBLENDMODE_PinLight:
        case ODYSSEY_COLORBLENDMODE_HardMix:
        case ODYSSEY_COLORBLENDMODE_Phoenix:
        case ODYSSEY_COLORBLENDMODE_Reflect:
        case ODYSSEY_COLORBLENDMODE_Glow:
        case ODYSSEY_COLORBLENDMODE_Difference:
        case ODYSSEY_COLORBLENDMODE_Exclusion:
        case ODYSSEY_COLORBLENDMODE_Add:
        case ODYSSEY_COLORBLENDMODE_Substract:
        case ODYSSEY_COLORBLENDMODE_Divide:
        case ODYSSEY_COLORBLENDMODE_Average:
        case ODYSSEY_COLORBLENDMODE_Negation:
        case ODYSSEY_COLORBLENDMODE_Dissolve:
        case ODYSSEY_COLORBLENDMODE_BayerDither8x8:
            return true;

        case ODYSSEY_COLORBLENDMODE_DarkerColor:
        case ODYSSEY_COLORBLENDMODE_LighterColor:
        case ODYSSEY_COLORBLENDMODE_Hue:
        case ODYSSEY_COLORBLENDMODE_Saturation:
        case ODYSSEY_COLORBLENDMODE_Color:
        case ODYSSEY_COLORBLENDMODE_Luminosity:
        case ODYSSEY_COLORBLENDMODE_PartialDerivative:
        case ODYSSEY_COLORBLENDMODE_WhiteOut:
        case ODYSSEY_COLORBLENDMODE_AngleCorrected:
            return false;
    }

    return false;
}

// Simple solid color pixel shader
float Lum(float3 iC)
{
    return iC.x * 0.3 + iC.y * 0.59 + iC.z * 0.11;
}

float3 ClipColor(float3 iC)
{
    float3 c = iC;
    float l = Lum(iC);
    float n = min3(iC.x, iC.y, iC.z);
    float x = max3(iC.x, iC.y, iC.z);

    //

    if (n < 0.f)
    {
        float ln = ensureNonZero(l - n);
        c.x = l + (((c.x - l) * l) / ln);
        c.y = l + (((c.y - l) * l) / ln);
        c.z = l + (((c.z - l) * l) / ln);
    }
    else if (x > 1.f)
    {
        float xl = ensureNonZero(x - l);

        c.x = l + (((c.x - l) * (1.f - l)) / xl);
        c.y = l + (((c.y - l) * (1.f - l)) / xl);
        c.z = l + (((c.z - l) * (1.f - l)) / xl);
    }

    return c;
}

float3 SetLum(float3 iC, float iL)
{
    float d = iL - Lum(iC);
    iC.x = iC.x + d;
    iC.y = iC.y + d;
    iC.z = iC.z + d;

    return ClipColor(iC);
}

float Sat(float3 iC)
{
    return max3(iC.x, iC.y, iC.z) - min3(iC.x, iC.y, iC.z);
}

float3 SetSatComponent(float3 iC, int iIndex, float iValue)
{
    if (iIndex == 0)
    {
        iC.x = iValue;
    }
    else if (iIndex == 1)
    {
        iC.y = iValue;
    }
    else
    {
        iC.z = iValue;
    }

    return iC;
}

float3 SetSat(float3 iC, float iS)
{
    int maxIndex = (iC.x > iC.y) ? ((iC.x > iC.z) ? 0 : 2) : ((iC.y > iC.z) ? 1 : 2);
    int minIndex = (iC.x < iC.y) ? ((iC.x < iC.z) ? 0 : 2) : ((iC.y < iC.z) ? 1 : 2);
    int midIndex = (maxIndex == minIndex) ? minIndex : 3 - minIndex - maxIndex;
    float Cmax = iC[maxIndex];
    float Cmin = iC[minIndex];
    float Cmid = iC[midIndex];

    if (Cmax > Cmin)
    {
        Cmid = (((Cmid - Cmin) * iS) / ensureNonZero(Cmax - Cmin));
        Cmax = iS;

    }
    else
    {
        Cmid = 0.f;
        Cmax = 0.f;
    }

    Cmin = 0.f;

    if (maxIndex == minIndex)
    {
        minIndex = 0;
        midIndex = 1;
        maxIndex = 2;
    }

    iC = SetSatComponent(iC, minIndex, Cmin);
    iC = SetSatComponent(iC, midIndex, Cmid);
    iC = SetSatComponent(iC, maxIndex, Cmax);

    return iC;
}

float BlendNormal(float iCb, float iCs)
{
    return iCs;
}

float BlendTop(float iCb, float iCs)
{
    return iCs;
}

float BlendBack(float iCb, float iCs)
{
    return iCb;
}

float BlendBehind(float iCb, float iCs)
{
    return iCb;
}

float BlendDarken(float iCb, float iCs)
{
    return min(iCb, iCs);
}

float BlendMultiply(float iCb, float iCs)
{
    return iCb * iCs;
}

float BlendColorBurn(float iCb, float iCs)
{
    return iCs > 0.f ? (1.f - min(1.f, (1.f - iCb) / ensureNonZero(iCs))) : 0.f;
}

float BlendLighten(float iCb, float iCs)
{
    return max(iCb, iCs);
}

float BlendAverage(float iCb, float iCs)
{
    return (iCs + iCb) / 2.f;
}

float BlendNegation(float iCb, float iCs)
{
    return 1.f - abs(1.f - iCs - iCb);
}

float BlendScreen(float iCb, float iCs)
{
    return iCb + iCs - (iCb * iCs);
}

float BlendColorDodge(float iCb, float iCs)
{
    return iCs == 1.0f ? 1.f : min(1.f, iCb / ensureNonZero(1.f - iCs));
}

float BlendAdd(float iCb, float iCs)
{
    return min(1.f, iCs + iCb);
}

float BlendLinearDodge(float iCb, float iCs)
{
    return min(1.f, iCs + iCb);
}

float BlendSoftLight(float iCb, float iCs)
{
    if (iCs <= 0.5f)
    {
        return iCb - (1.f - 2.f * iCs) * iCb * (1 - iCb);
    }

    float d = iCb <= 0.25f ? ((16.f * iCb - 12.f) * iCb + 4) * iCb : sqrt(iCb);
    return iCb + (2.f * iCs - 1.f) * (d * iCb);
}

float BlendLinearBurn(float iCb, float iCs)
{
    return max(0.f, iCs + iCb - 1.f);
}

float BlendHardLight(float iCb, float iCs)
{
    return iCs <= 0.5f ? BlendMultiply(iCb, 2.f * iCs) : BlendScreen(iCb, 2 * iCs - 1.f);
}

float BlendOverlay(float iCb, float iCs)
{
    return BlendHardLight(iCs, iCb);
}

float BlendVividLight(float iCb, float iCs)
{
    return iCs <= 0.5f ? BlendColorBurn(iCb, 2 * iCs) : BlendColorDodge(iCb, 2 * (iCs - 0.5f));
}

float BlendLinearLight(float iCb, float iCs)
{
    return clamp(iCb + 2.f * iCs - 1.f, 0.f, 1.f);
}

float BlendPinLight(float iCb, float iCs)
{
    return iCs > 0.5f ? max(iCb, 2.f * iCs - 1.f) : min(iCb, 2.f * iCs);
}

float BlendHardMix(float iCb, float iCs)
{
    return iCs + iCb < 0.999f ? 0 : iCs + iCb > 1.001f ? 1.f : iCb > iCs            ? 1.f : 0.f;
}

float BlendDifference(float iCb, float iCs)
{
    return abs(iCb - iCs);
}

float BlendExclusion(float iCb, float iCs)
{
    return iCb + iCs - 2.f * iCb * iCs;
}

float BlendSubstract(float iCb, float iCs)
{
    return max(0.f, iCb - iCs);
}

float BlendDivide(float iCb, float iCs)
{
    return iCs == 0.f && iCb == 0.f ? 0.f : iCs == 0.f && iCb != 0.f ? 1.f : clamp(iCb / ensureNonZero(iCs), 0.f, 1.f);
}

float BlendPhoenix(float iCb, float iCs)
{
    return 1.f - max(iCs, iCb) + min(iCs, iCb);
}

float BlendReflect(float iCb, float iCs)
{
    return iCb == 1.f ? 1.f : min(1.f, iCs * iCs / ensureNonZero(1.f - iCb));
}

float BlendGlow(float iCb, float iCs)
{
    return BlendReflect(iCs, iCb);
}

float BlendDissolve(float iCb, float iCs, float iCsA, uint2 iDstPos)
{
    float randomAlpha = RandFast(iDstPos);
    return randomAlpha < iCsA ? iCs : iCb;
}

float BlendBayerDither8x8(float iCb, float iCs, float iCsA, uint2 iDstPos)
{
    float bayerEl = GetBayerDither8x8(iDstPos);
    return (iCsA >= bayerEl) ? iCs : iCb;
}

//--------------------------------------------------------------------------------------
//-------------------------------------------------------------------------- DarkerColor
float3 BlendDarkerColor(float3 iCs, float3 iCb) {
    return Lum(iCb) < Lum(iCs) ? iCb : iCs;
}
//--------------------------------------------------------------------------------------
//------------------------------------------------------------------------- LighterColor
float3 BlendLighterColor(float3 iCs, float3 iCb) {
    return Lum(iCb) > Lum(iCs) ? iCb : iCs;
}

float3 BlendHue(float3 iCb, float3 iCs)
{
    return SetLum(SetSat(iCs, Sat(iCb)), Lum(iCb));
}

float3 BlendSaturation(float3 iCb, float3 iCs)
{
    return SetLum(SetSat(iCb, Sat(iCs)), Lum(iCb));
}

float3 BlendColor(float3 iCb, float3 iCs)
{
    return SetLum(iCs, Lum(iCb));
}

float3 BlendLuminosity(float3 iCb, float3 iCs)
{
    return SetLum(iCb, Lum(iCs));
}

float Distance(float3 iValue)
{
    return sqrt(iValue.x * iValue.x + iValue.y * iValue.y + iValue.z * iValue.z);
}

float3 Normalize(float3 iValue)
{
    float distance = Distance(iValue);
    if (distance == 0)
        return float3(0, 0, 0);

    return float3(
        iValue.x / ensureNonZero(distance),
        iValue.y / ensureNonZero(distance),
        iValue.z / ensureNonZero(distance)
    );
}

//--------------------------------------------------------------------------------------
//------------------------------------------------------------------- Partial Derivative
float3 BlendPartialDerivative(float3 iCs, float3 iCb) {
    float3 cs = iCs * 2.f - 1.f;
    float3 cb = iCb * 2.f - 1.f;

    float3 res = float3(cs.x * cb.z + cb.x * cs.z, cs.y * cb.z + cb.y * cs.z, cs.z * cb.z);
    res = Normalize(res) * 0.5f + 0.5f;
    return res;
}
//--------------------------------------------------------------------------------------
//----------------------------------------------------------------------------- Whiteout
float3 BlendWhiteOut(float3 iCs, float3 iCb) {
    float3 cs = iCs * 2.f - 1.f;
    float3 cb = iCb * 2.f - 1.f;
    float3 res = float3(cs.x + cb.x, cs.y + cb.y, cs.z * cb.z);
    res = Normalize(res) * 0.5f + 0.5f;
    return res;
}
//--------------------------------------------------------------------------------------
//----------------------------------------------------------------------- AngleCorrected
float3 BlendAngleCorrected(float3 iCs, float3 iCb) {
    float3 cs = iCs * 2.f - 1.f;
    float3 cb = iCb * 2.f - 1.f;
    float3 res = float3(cs.x + cb.x, cs.y + cb.y, cs.z);
    res = Normalize(res) * 0.5f + 0.5f;
    return res;
}

float BlendComponent(float iCb, float iCs, float iCbA, float iCsA, uint iBlendingMode, uint2 iDstPos)
{
    switch (iBlendingMode)
    {
        case ODYSSEY_COLORBLENDMODE_Normal:
        {
            return BlendNormal(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Top:
        {
            return BlendTop(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Back:
        {
            return BlendBack(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Behind:
        {
            return BlendBehind(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Darken:
        {
            return BlendDarken(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Multiply:
        {
            return BlendMultiply(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_ColorBurn:
        {
            return BlendColorBurn(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_LinearBurn:
        {
            return BlendLinearBurn(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Lighten:
        {
            return BlendLighten(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Screen:
        {
            return BlendScreen(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_ColorDodge:
        {
            return BlendColorDodge(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_LinearDodge:
        {
            return BlendLinearDodge(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Overlay:
        {
            return BlendOverlay(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_SoftLight:
        {
            return BlendSoftLight(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_HardLight:
        {
            return BlendHardLight(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_VividLight:
        {
            return BlendVividLight(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_LinearLight:
        {
            return BlendLinearLight(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_PinLight:
        {
            return BlendPinLight(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_HardMix:
        {
            return BlendHardMix(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Phoenix:
        {
            return BlendPhoenix(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Reflect:
        {
            return BlendReflect(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Glow:
        {
            return BlendGlow(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Difference:
        {
            return BlendDifference(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Exclusion:
        {
            return BlendExclusion(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Add:
        {
            return BlendAdd(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Substract:
        {
            return BlendSubstract(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Divide:
        {
            return BlendDivide(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Average:
        {
            return BlendAverage(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Negation:
        {
            return BlendNegation(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Dissolve:
        {
            return BlendDissolve(iCb, iCs, iCsA, iDstPos);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_BayerDither8x8:
        {
            return BlendBayerDither8x8(iCb, iCs, iCsA, iDstPos);
        }
        break;
    }

    return 0.f;
}

float AlphaNormal(float iCb, float iCs)
{
    return iCb + iCs - (iCb * iCs);
}

float AlphaErase(float iCb, float iCs) {
    return (1.f - iCs) * iCb;
}

float AlphaBack(float iCb, float iCs) {
    return iCb;
}

float AlphaTop(float iCb, float iCs) {
    return iCs;
}

float AlphaSubstract(float iCb, float iCs) {
    return iCb > iCs ? iCb - iCs : 0;
}

float AlphaAdd(float iCb, float iCs) {
    return (1.f - iCb) > iCs ? iCb + iCs : 1.f;
}

float AlphaMultiply(float iCb, float iCs) {
    return iCb * iCs;
}

float AlphaMin(float iCb, float iCs) {
    return min(iCs, iCb);
}

float AlphaMax(float iCb, float iCs) {
    return max(iCs, iCb);
}

float AlphaDissolve(float iCb, float iCs, uint2 iDstPos) {
    float randomAlpha = RandFast(iDstPos);
    return (randomAlpha < iCs) ? iCs : iCb;
}

float AlphaBayerDither8x8(float iCb, float iCs, uint2 iDstPos) {
    float bayerEl = GetBayerDither8x8(iDstPos);
    return (iCs >= bayerEl) ? iCs : iCb;
}

float AlphaBlend(float iCb, float iCs, uint iAlphaBlend, uint2 iDstPos)
{
    switch (iAlphaBlend)
    {
        case ODYSSEY_ALPHABLENDMODE_Normal:
        {
            return AlphaNormal(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Erase:
        {
            return AlphaErase(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Top:
        {
            return AlphaTop(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Back:
        {
            return AlphaBack(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Substract:
        {
            return AlphaSubstract(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Add:
        {
            return AlphaAdd(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Multiply:
        {
            return AlphaMultiply(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Min:
        {
            return AlphaMin(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Max:
        {
            return AlphaMax(iCb, iCs);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_Dissolve:
        {
            return AlphaDissolve(iCb, iCs, iDstPos);
        }
        break;

        case ODYSSEY_ALPHABLENDMODE_BayerDither8x8:
        {
            return AlphaBayerDither8x8(iCb, iCs, iDstPos);
        }
        break;
    }

    return 0.f;
}

float4 BlendSeparable(float4 iCb, float4 iCs, float iOpacity, uint iBlendMode, uint iAlphaMode, uint2 iDstPos)
{
    float4 outColor = float4(0.f, 0.f, 0.f, 0.f);

    float csR = iCs.x;
    float cbR = iCb.x;
    float csG = iCs.y;
    float cbG = iCb.y;
    float csB = iCs.z;
    float cbB = iCb.z;
    float csA = iCs.w * iOpacity;
    float cbA = iCb.w;

    float comp = AlphaNormal(cbA, csA);
    comp = comp == 0.f ? 0.f : csA / comp;

    outColor.x = (1.0f - comp ) * cbR + comp  * ((1.0f - cbA) * csR + cbA * BlendComponent(cbR, csR, cbA, csA, iBlendMode, iDstPos));
    outColor.y = (1.0f - comp ) * cbG + comp  * ((1.0f - cbA) * csG + cbA * BlendComponent(cbG, csG, cbA, csA, iBlendMode, iDstPos));
    outColor.z = (1.0f - comp ) * cbB + comp  * ((1.0f - cbA) * csB + cbA * BlendComponent(cbB, csB, cbA, csA, iBlendMode, iDstPos));

    outColor.w = AlphaBlend(cbA, csA, iAlphaMode, iDstPos);

    return outColor;
}

float3 BlendNonSeparableComponents(float3 iCb, float3 iCs, uint iBlendMode)
{
    switch (iBlendMode)
    {
        case ODYSSEY_COLORBLENDMODE_DarkerColor:
        {
            return BlendDarkerColor(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_LighterColor:
        {
            return BlendLighterColor(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Hue:
        {
            return BlendHue(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Saturation:
        {
            return BlendSaturation(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Color:
        {
            return BlendColor(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_Luminosity:
        {
            return BlendLuminosity(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_PartialDerivative:
        {
            return BlendPartialDerivative(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_WhiteOut:
        {
            return BlendWhiteOut(iCb, iCs);
        }
        break;

        case ODYSSEY_COLORBLENDMODE_AngleCorrected:
        {
            return BlendAngleCorrected(iCb, iCs);
        }
        break;
    }
    return float3(0, 0, 0);
}

float4 BlendNonSeparable(float4 iCb, float4 iCs, float iOpacity, uint iBlendMode, uint iAlphaMode, uint2 iDstPos)
{
    float4 outColor = float4(0.f, 0.f, 0.f, 0.f);

    float csR = iCs.x;
    float cbR = iCb.x;
    float csG = iCs.y;
    float cbG = iCb.y;
    float csB = iCs.z;
    float cbB = iCb.z;
    float csA = iCs.w * iOpacity;
    float cbA = iCb.w;

    float comp = AlphaNormal(cbA, csA);
    comp = comp == 0.f ? 0.f : csA / comp;

    float3 cb3 = float3(iCb.x, iCb.y, iCb.z);
    float3 cs3 = float3(iCs.x, iCs.y, iCs.z);
    float3 components = BlendNonSeparableComponents(cb3, cs3, iBlendMode);

    outColor.x = (1.0f - comp) * cbR + comp * ((1.0f - cbA) * csR + cbA * components.x);
    outColor.y = (1.0f - comp) * cbG + comp * ((1.0f - cbA) * csG + cbA * components.y);
    outColor.z = (1.0f - comp) * cbB + comp * ((1.0f - cbA) * csB + cbA * components.z);
    outColor.w = AlphaBlend(cbA, csA, iAlphaMode, iDstPos);

    return outColor;
}

float4 Blend(float4 iCb, float4 iCs, float iOpacity, uint iBlendMode, uint iAlphaMode, uint2 iDstPos)
{
    if (IsBlendSeparable(iBlendMode))
        return BlendSeparable(iCb, iCs, iOpacity, iBlendMode, iAlphaMode, iDstPos);

    return BlendNonSeparable(iCb, iCs, iOpacity, iBlendMode, iAlphaMode, iDstPos);
}
