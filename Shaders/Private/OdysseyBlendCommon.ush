#include "/Engine/Private/common.ush"
#include "/Engine/Private/Random.ush"

#define SMALL_NUMBER 1e-8

float ensureNonZero( float iValue )
{
    if (iValue == 0.f)
        return SMALL_NUMBER;

    return iValue;
}

// ColorBlendMode Seperarable
#define ODYSSEY_COLORBLENDMODE_Normal 0
#define ODYSSEY_COLORBLENDMODE_Behind 1

#define ODYSSEY_COLORBLENDMODE_Top 2
#define ODYSSEY_COLORBLENDMODE_Back 3

#define ODYSSEY_COLORBLENDMODE_Darken 4
#define ODYSSEY_COLORBLENDMODE_Multiply 5
#define ODYSSEY_COLORBLENDMODE_ColorBurn 6
#define ODYSSEY_COLORBLENDMODE_LinearBurn 7
