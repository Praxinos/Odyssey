#define ODYSSEY_COLORBLENDMODE_Saturation 32
#define ODYSSEY_COLORBLENDMODE_Color 33
#define ODYSSEY_COLORBLENDMODE_Luminosity 34

#define ODYSSEY_COLORBLENDMODE_PartialDerivative 35
#define ODYSSEY_COLORBLENDMODE_WhiteOut 36
#define ODYSSEY_COLORBLENDMODE_AngleCorrected 37

#define ODYSSEY_COLORBLENDMODE_Dissolve 38
