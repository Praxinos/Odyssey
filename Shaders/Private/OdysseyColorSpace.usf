#include "/Engine/Public/Platform.ush"

// Converts straight alpha colors between linear and sRGB encoded values, alpha excepted.
// Pixels are read at their own position: no filtering happens.

Texture2D SourceTexture;

// 0: linear to sRGB encoded, 1: sRGB encoded to linear
uint Conversion;

float EncodeSRGB(float Linear)
{
    if (Linear <= 0.0031308f)
    {
        return Linear * 12.92f;
    }
    return 1.055f * pow(Linear, 1.0f / 2.4f) - 0.055f;
}

float DecodeSRGB(float Encoded)
{
    if (Encoded <= 0.04045f)
    {
        return Encoded / 12.92f;
    }
    return pow((Encoded + 0.055f) / 1.055f, 2.4f);
}

void MainPS(
    float4 SvPosition : SV_POSITION,
    out float4 OutColor : SV_Target0
)
{
    float4 Color = SourceTexture.Load(int3(SvPosition.xy, 0));
    if (Conversion == 0)
    {
        OutColor = float4(EncodeSRGB(Color.r), EncodeSRGB(Color.g), EncodeSRGB(Color.b), Color.a);
    }
    else
    {
        OutColor = float4(DecodeSRGB(Color.r), DecodeSRGB(Color.g), DecodeSRGB(Color.b), Color.a);
    }
}
