#include "/Engine/Public/Platform.ush"

Texture2D InputTexture;

StructuredBuffer<int2> TilePositions;
uint TileSize;
uint NumTiles;
RWBuffer<uint> IsTileEmpty;

// Tells, for each tile, whether all its pixels are transparent.
//
// One thread group processes one tile, and a single thread of the group scans its pixels.
// TilePositions are the top-left corners of the tiles, in pixels; pixels outside the texture are ignored.
// Only the alpha is tested: a transparent pixel with a color is empty.
//
// Result convention, one uint per tile in IsTileEmpty:
//   1 = tile is empty (every alpha value is 0)
//   0 = tile contains content (at least one alpha value is != 0)
[numthreads(1, 1, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID)
{
    const uint TileIndex = GroupId.x;

    if (TileIndex >= NumTiles)
    {
        return;
    }

    const int2 TilePosition = TilePositions[TileIndex];

    uint TextureWidth;
    uint TextureHeight;

    InputTexture.GetDimensions(
        TextureWidth,
        TextureHeight
    );

    bool bIsEmpty = true;

    for (uint LocalY = 0; LocalY < TileSize; ++LocalY)
    {
        const int PixelY =
            TilePosition.y + int(LocalY);

        if (PixelY < 0 || PixelY >= int(TextureHeight))
        {
            continue;
        }

        for (uint LocalX = 0; LocalX < TileSize; ++LocalX)
        {
            const int PixelX =
                TilePosition.x + int(LocalX);

            if (PixelX < 0 || PixelX >= int(TextureWidth))
            {
                continue;
            }

            const float Alpha =
                InputTexture.Load(int3(
                    PixelX,
                    PixelY,
                    0
                )).a;

            if (Alpha != 0.0f)
            {
                bIsEmpty = false;
                break;
            }
        }

        if (!bIsEmpty)
        {
            break;
        }
    }

    IsTileEmpty[TileIndex] = bIsEmpty ? 1u : 0u;
}
