#include "/Engine/Public/Platform.ush"

Texture2D InputTexture;

StructuredBuffer<int2> TilePositions;
uint TileSize;
uint NumTiles;
RWBuffer<uint> IsTileEmpty;

// One thread group processes exactly one tile.
// 8x8 = 64 threads per tile.
//
// Each thread scans a strided subset of the tile and keeps the result in a
// thread-local boolean. A groupshared reduction combines the 64 results.
// Only thread 0 writes the final result to the output buffer.
//
// Result convention:
//   1 = tile is empty (all sampled alpha values are 0)
//   0 = tile contains content (at least one alpha value is != 0)

// One thread group processes one tile.
// Only one thread actually does the work.
[numthreads(1, 1, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID)
{
    const uint TileIndex = GroupId.x;

    if (TileIndex >= NumTiles)
    {
        return;
    }

    const int2 TilePosition = TilePositions[TileIndex];

    uint TextureWidth;
    uint TextureHeight;

    InputTexture.GetDimensions(
        TextureWidth,
        TextureHeight
    );

    bool bIsEmpty = true;

    for (uint LocalY = 0; LocalY < TileSize; ++LocalY)
    {
        const int PixelY =
            TilePosition.y + int(LocalY);

        if (PixelY < 0 || PixelY >= int(TextureHeight))
        {
            continue;
        }

        for (uint LocalX = 0; LocalX < TileSize; ++LocalX)
        {
            const int PixelX =
                TilePosition.x + int(LocalX);

            if (PixelX < 0 || PixelX >= int(TextureWidth))
            {
                continue;
            }

            const float Alpha =
                InputTexture.Load(int3(
                    PixelX,
                    PixelY,
                    0
                )).a;

            if (Alpha != 0.0f)
            {
                bIsEmpty = false;
                break;
            }
        }

        if (!bIsEmpty)
        {
            break;
        }
    }

    IsTileEmpty[TileIndex] = bIsEmpty ? 1u : 0u;
}

