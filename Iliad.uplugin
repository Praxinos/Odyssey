    {
      "Name": "OdysseyEditorBrushBlueprints",
      "Type": "UncookedOnly",
      "LoadingPhase": "Default",
      "Comment": "OdysseyBrush is UncookedOnly so that its nodes can be used in FunctionLibraries. And having this module avoids switching main editor modules to UncookedOnly"
    },
