{
    "FileVersion": 3,
    "Version": 1,
    "VersionName": "1.0.56",
    "FriendlyName": "Odyssey",
    "Description": "2D Animation, Storyboard & Animatic plugin for Unreal Engine",
    "Category": "2D",
    "CreatedBy": "Praxinos",
    "CreatedByURL": "https://praxinos.coop",
    "DocsURL": "https://praxinos.coop/Documentation/Odyssey/v2.1/",
    "MarketplaceURL": "",
    "SupportURL": "https://praxinos.coop/contact",
    "CanContainContent": true,
    "IsBetaVersion": false,
    "IsExperimentalVersion": false,
    "Installed": false,
    "LocalizationTargets": [
        {
        "Name": "Epos",
        "LoadingPolicy": "Editor"
        },
        {
            "Name": "Iliad",
            "LoadingPolicy": "Editor"
        }
    ],
    "Plugins": [
        {
            "Enabled": true,
            "Name": "LevelSequenceEditor"
        },
        {
            "Enabled": true,
            "Name": "EditorScriptingUtilities"
        },
        {
            "Enabled": true,
            "Name": "MovieRenderPipeline"
        },
        {
            "Enabled": true,
            "Name": "SequencerScripting"
        },
        {
            "Enabled": true,
