    "PreBuildSteps": {
        "Win64": [
            "copy /Y \"$(PluginDir)\\Config\\BaseOdyssey.ini\" \"$(PluginDir)\\Config\\DefaultOdyssey.ini\""
        ],
        "Mac": [
            "cp \"$(PluginDir)/Config/BaseOdyssey.ini\" \"$(PluginDir)/Config/DefaultOdyssey.ini\""
        ]
    }
